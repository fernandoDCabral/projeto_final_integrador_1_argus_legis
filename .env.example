# Copie o que está nesse arquivo em um novo arquivo .env e
# substitua as informações com as suas!

POSTGRES_USER=admin_argus
POSTGRES_PASSWORD=senha_exemplo
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nome_do_banco_exemplo
DATABASE_URL=postgresql://usuario_exemplo:senha_exemplo@db:5432/nome_do_banco_exemplo

# Crie sua chave secreta e insira no campo SECRET_KEY. 
# Ela deve ser uma string longa e aleatória para garantir a segurança dos tokens JWT.
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações do Frontend / CORS
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_NAME="Argus Legis"
DEBUG=True

# --- Envio de e-mail (recuperação de senha) ---
# Opcional: sem SMTP_USER e SMTP_PASSWORD o sistema continua funcionando e
# escreve o link de recuperação no log do servidor em vez de enviar por e-mail.
#
# Para usar o Gmail:
#   1. Ative a verificação em duas etapas na sua Conta Google
#   2. Gere uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. Cole a senha de 16 caracteres em SMTP_PASSWORD (sem espaços)
# A senha de app NÃO é a senha da sua conta Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Argus Legis"

# Validade do link de redefinição de senha, em minutos
RESET_TOKEN_EXPIRE_MINUTES=60

# --- Consulta de processos no DataJud (CNJ) ---
# Opcional: o sistema já usa a chave pública atual do CNJ. Preencha só se o CNJ
# trocar a chave (https://datajud-wiki.cnj.jus.br/api-publica/acesso/)
# DATAJUD_API_KEY=
