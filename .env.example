# Copie o que está nesse arquivo em um novo arquivo .env e
# substitua as informações com as suas!

POSTGRES_USER=admin_argus
POSTGRES_PASSWORD=senha_exemplo
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nome_do_banco_exemplo
DATABASE_URL=postgresql://usuario_exemplo:senha_exemplo@db:5432/nome_do_banco_exemplo

# Crie sua chave secreta e insira no campo SECRET_KEY. 
# Ela deve ser uma string longa e aleatória para garantir a segurança dos tokens JWT.
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações do Frontend / CORS
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_NAME="Argus Legis"
DEBUG=True